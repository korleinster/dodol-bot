#!/bin/sh
# Root-owned fixed allow-list helper for Telegram service control.
# Install as /usr/local/sbin/leinygames-service-control with mode 0755 and
# root:root ownership. Never make this file writable by the controller user.
set -eu
umask 077
IFS=$(printf ' \t\n_')
IFS=${IFS%_}
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset DOCKER_HOST DOCKER_CONTEXT DOCKER_TLS_VERIFY DOCKER_CERT_PATH
unset COMPOSE_FILE COMPOSE_PROJECT_NAME HTTP_PROXY HTTPS_PROXY ALL_PROXY
unset http_proxy https_proxy all_proxy CDPATH ENV BASH_ENV

if [ "$#" -ne 2 ]; then
  echo "rejected INVALID_ARGUMENTS"
  exit 64
fi

action=$1
service_id=$2

case "$action" in
  status|restart) ;;
  *) echo "rejected ACTION_NOT_ALLOWED"; exit 64 ;;
esac

case "$service_id" in
  1) service_name="dodol-bot-001" ;;
  2) service_name="dodol-bot-002" ;;
  3) service_name="dodol-bot-003" ;;
  4) service_name="dodol-bot-004" ;;
  5) service_name="leinster-center" ;;
  *) echo "rejected SERVICE_NOT_ALLOWED"; exit 64 ;;
esac

DOCKER=/usr/bin/docker
SYSTEMCTL=/usr/bin/systemctl
CURL=/usr/bin/curl
FLOCK=/usr/bin/flock
COMPOSE_PROJECT=dodol-bot

find_bot_container() {
  # Select one existing Compose-managed container by its fixed service label.
  # This avoids parsing a user-writable Compose file in a root process.
  set -- $($DOCKER ps -aq \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=$service_name" 2>/dev/null || true)
  if [ "$#" -eq 0 ]; then
    echo "stopped CONTAINER_NOT_FOUND"
    return 3
  fi
  if [ "$#" -ne 1 ]; then
    echo "unhealthy CONTAINER_ID_AMBIGUOUS"
    return 3
  fi
  case "$1" in
    *[!0-9a-f]*) echo "unhealthy CONTAINER_ID_INVALID"; return 3 ;;
  esac
  container_id=$1
}

bot_status() {
  container_id=""
  find_bot_container || return $?
  state=$($DOCKER inspect --format '{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container_id" 2>/dev/null || true)
  case "$state" in
    "true healthy") echo "ready HEALTHY"; return 0 ;;
    "true starting") echo "starting HEALTHCHECK_STARTING"; return 2 ;;
    "true unhealthy") echo "unhealthy HEALTHCHECK_FAILED"; return 3 ;;
    "true missing") echo "unhealthy HEALTHCHECK_MISSING"; return 3 ;;
    *) echo "stopped CONTAINER_NOT_RUNNING"; return 3 ;;
  esac
}

center_status() {
  if ! $SYSTEMCTL is-active --quiet leinster-center; then
    echo "stopped SERVICE_NOT_ACTIVE"
    return 3
  fi
  if $CURL --fail --silent --show-error --max-time 5 http://127.0.0.1:8090/api/health >/dev/null 2>&1; then
    echo "ready HEALTHY"
    return 0
  fi
  echo "unhealthy HEALTHCHECK_FAILED"
  return 3
}

if [ "$action" = "status" ]; then
  if [ "$service_id" = "5" ]; then
    center_status
  else
    bot_status
  fi
  exit $?
fi

if [ "$service_id" = "5" ]; then
  exec 9>/run/leinygames-service-control.lock
  if ! $FLOCK -n 9; then
    echo "rejected CONTROL_BUSY"
    exit 75
  fi
  $SYSTEMCTL restart leinster-center
else
  exec 9>/run/leinygames-service-control.lock
  if ! $FLOCK -n 9; then
    echo "rejected CONTROL_BUSY"
    exit 75
  fi
  container_id=""
  find_bot_container || exit $?
  $DOCKER restart "$container_id" >/dev/null
fi
echo "accepted RESTART_REQUESTED"
