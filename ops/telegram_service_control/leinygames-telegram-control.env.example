# Use a dedicated BotFather bot. Do not reuse the token consumed by /announce.
TELEGRAM_CONTROL_BOT_TOKEN=replace_with_dedicated_token
TELEGRAM_CONTROL_CHAT_ID=replace_with_private_chat_id
TELEGRAM_CONTROL_OWNER_USER_ID=replace_with_owner_user_id
TELEGRAM_CONTROL_AUDIT_DB=/var/lib/leinygames-telegram-control/audit.sqlite
TELEGRAM_CONTROL_HELPER=/usr/local/sbin/leinygames-service-control
