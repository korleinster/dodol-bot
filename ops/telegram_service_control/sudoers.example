# Install as /etc/sudoers.d/leinygames-telegram-control with mode 0440.
# Every allowed argv is enumerated. Do not replace these entries with `*`.
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control status 1
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control status 2
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control status 3
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control status 4
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control status 5
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control restart 1
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control restart 2
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control restart 3
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control restart 4
leinster ALL=(root) NOPASSWD: /usr/local/sbin/leinygames-service-control restart 5
