# 봇 토큰 (번호별로 추가, 없는 번호는 인스턴스 미생성)
DISCORD_TOKEN_001=your_token_here
#DISCORD_TOKEN_002=your_token_here
#DISCORD_TOKEN_003=your_token_here
#DISCORD_TOKEN_004=your_token_here

# PLAYNC 개발자센터 API 키
PLAYNC_API_KEY=your_api_key_here

# DB 경로 (Docker 볼륨 마운트 기준 — 변경 불필요)
DB_PATH=./data/bot.db

# Per-bot Edge Neural TTS. No API secret is required. Set one bot's provider
# to gtts for an independent no-code rollback to the previous voice.
TTS_PROVIDER_001=edge
TTS_EDGE_VOICE_001=ko-KR-SunHiNeural
TTS_EDGE_RATE_001=+8%
TTS_EDGE_PITCH_001=+8Hz
TTS_PROVIDER_002=edge
TTS_EDGE_VOICE_002=ko-KR-SunHiNeural
TTS_EDGE_RATE_002=+8%
TTS_EDGE_PITCH_002=+8Hz
TTS_PROVIDER_003=edge
TTS_EDGE_VOICE_003=ko-KR-SunHiNeural
TTS_EDGE_RATE_003=+8%
TTS_EDGE_PITCH_003=+8Hz
TTS_PROVIDER_004=edge
TTS_EDGE_VOICE_004=ko-KR-SunHiNeural
TTS_EDGE_RATE_004=+8%
TTS_EDGE_PITCH_004=+8Hz
