# Keep the build context limited to the runtime application.
**
!requirements.txt
!main.py
!src/
!src/**

# Runtime secrets and local configuration stay excluded even if misplaced
# beneath an allowed source directory.
.env*
**/.env*
*.env
**/*.env
*.env.*
**/*.env.*
*.secret
**/*.secret

# Persistent runtime state
data/
**/data/
logs/
**/logs/
backups/
**/backups/
backup/
**/backup/
*.log
**/*.log
*.db
**/*.db
*.db-*
**/*.db-*
*.sqlite
**/*.sqlite
*.sqlite-*
**/*.sqlite-*

# Version-control metadata
.git/
**/.git/
.gitignore
**/.gitignore
.gitattributes
**/.gitattributes
.github/
**/.github/
.hg/
**/.hg/
.svn/
**/.svn/

# Python caches, virtual environments, and build output
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage*
**/.coverage*
htmlcov/
**/htmlcov/
.tox/
**/.tox/
.nox/
**/.nox/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
*.egg-info/
**/*.egg-info/
build/
**/build/
dist/
**/dist/
